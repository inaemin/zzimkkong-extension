{
  "compilerOptions": {
    // Vite(esbuild)가 트랜스파일하므로 tsc 는 타입 검사만 한다.
    "noEmit": true,

    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],

    // 점진 전환용. .js 와 .ts 가 공존해야 하고,
    // 아직 타입이 없는 .js 는 검사하지 않는다(checkJs 미설정).
    "allowJs": true,

    // 하위 플래그를 하나씩 켜서 전부 0건이 됐으므로 strict 로 묶는다.
    // (strictNullChecks 가 마지막이었다. 이제 새 플래그가 추가돼도 자동으로 켜진다.)
    "strict": true,

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,

    // React 19 JSX 변환(런타임 import 불필요).
    "jsx": "react-jsx",

    // 크롬 확장 API 타입.
    "types": ["chrome"],

    // shadcn 컴포넌트가 쓰는 경로 별칭.
    // moduleResolution: bundler 에서는 baseUrl 없이 paths 만으로 동작한다
    // (baseUrl 은 TS 7 에서 제거 예정).
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src/**/*", "tests/**/*", "scripts/**/*", "*.config.js", "*.config.ts"],
  "exclude": ["node_modules", "dist", "src-backup"]
}
