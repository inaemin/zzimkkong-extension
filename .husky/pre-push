# 푸시 전에 CI 와 같은 게이트를 미리 돌린다.
#
# 원본(server/client 분리 저장소)의 변경 경로 판별은 여기선 뺐다. 이 저장소는
# 단일 패키지라 src/ 든 tests/ 든 같은 검사를 받는다. 대신 "소스가 하나도 안
# 바뀐 푸시"(문서·설정만)에서는 건너뛴다.
branch=$(git rev-parse --abbrev-ref HEAD)

if git rev-parse --verify "origin/$branch" >/dev/null 2>&1; then
  changed_files=$(git diff "origin/$branch"..HEAD --name-only)
else
  base=$(git merge-base HEAD main 2>/dev/null) || base=""
  if [ -n "$base" ]; then
    changed_files=$(git diff "$base"..HEAD --name-only)
  else
    # main 이 없는 경우(클론 직후 등)엔 판단을 포기하고 전부 돌린다.
    changed_files="src/"
  fi
fi

if ! echo "$changed_files" | grep -qE '^(src/|tests/|.*\.(ts|tsx|js|json)$|eslint\.config\.js|tsconfig\.json)'; then
  echo "소스 변경이 없어 검사를 건너뜁니다."
  exit 0
fi

npm run check || exit 1
